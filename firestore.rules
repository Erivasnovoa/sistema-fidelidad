rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // La app pública usa /api/client. Solo la cuenta administradora de Firebase
    // Auth conserva acceso directo desde el navegador.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'Nb5fUqjRLJPSjzCviM89BrFgTny2';
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
